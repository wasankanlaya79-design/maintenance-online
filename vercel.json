{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/requester", "destination": "/requester.html" },
    { "source": "/approver", "destination": "/approver.html" },
    { "source": "/technician", "destination": "/technician.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}
      ]
    }
  ]
}
